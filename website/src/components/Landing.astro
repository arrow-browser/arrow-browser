---
import type { Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import Features from './Features.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Native from './Native.astro';
import OpenSource from './OpenSource.astro';
import Privacy from './Privacy.astro';
import Spaces from './Spaces.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
	<Header lang={lang} />
	<main>
		<Hero lang={lang} />
		<Spaces lang={lang} />
		<Features lang={lang} />
		<Privacy lang={lang} />
		<Native lang={lang} />
		<OpenSource lang={lang} />
	</main>
	<Footer lang={lang} />
</Base>
