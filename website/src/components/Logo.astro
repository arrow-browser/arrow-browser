---
// Arrow's app icon (the default "Lavender" variant drawn by scripts/make-icon.swift).
interface Props {
	size?: number;
	/** Distinguishes the gradient ids when the logo appears several times on a page. */
	id: string;
	class?: string;
}

const { size = 28, id, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
	<defs>
		<linearGradient id={`${id}-fill`} x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#8C78FF"></stop>
			<stop offset="0.5" stop-color="#D485F2"></stop>
			<stop offset="1" stop-color="#FF8FA3"></stop>
		</linearGradient>
		<linearGradient id={`${id}-shine`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#fff" stop-opacity="0.28"></stop>
			<stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
		</linearGradient>
		<clipPath id={`${id}-shape`}>
			<rect width="100" height="100" rx="22.4"></rect>
		</clipPath>
	</defs>
	<g clip-path={`url(#${id}-shape)`}>
		<rect width="100" height="100" fill={`url(#${id}-fill)`}></rect>
		<rect width="100" height="50" fill={`url(#${id}-shine)`}></rect>
	</g>
	<path
		d="M24 75 72 27M44 25h31v31"
		fill="none"
		stroke="#fff"
		stroke-width="11.5"
		stroke-linecap="round"
		stroke-linejoin="round"></path>
</svg>
