---
import { dictionaries, type Locale } from '../i18n';
import Icon, { type IconName } from './Icon.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = dictionaries[lang].native;

const cards: { id: keyof typeof t.cards; icon: IconName }[] = [
	{ id: 'mac', icon: 'window' },
	{ id: 'web', icon: 'globe' },
];
---

<section class="section" id="native">
	<div class="container">
		<header class="section-head reveal">
			<p class="eyebrow">{t.eyebrow}</p>
			<h2 class="section-title">{t.title}</h2>
		</header>
		<div class="cards">
			{
				cards.map((card) => (
					<article class="reveal">
						<span class="icon">
							<Icon name={card.icon} />
						</span>
						<h3>{t.cards[card.id].title}</h3>
						<p>{t.cards[card.id].body}</p>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;

		@media (max-width: 760px) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	article {
		display: grid;
		align-content: start;
		gap: 10px;
		padding: clamp(24px, 3vw, 40px);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow:
			inset 0 0 0 1px var(--line),
			var(--shadow-card);

		h3 {
			font-size: 1.375rem;
			font-weight: 650;
			letter-spacing: -0.02em;
		}

		p {
			max-width: 34rem;
			color: var(--text-muted);
		}
	}

	.icon {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		margin-bottom: 8px;
		border-radius: 13px;
		background: var(--accent-soft);
		color: var(--accent);
	}
</style>
