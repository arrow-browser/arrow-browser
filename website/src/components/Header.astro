---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { dictionaries, GITHUB_URL, type Locale } from '../i18n';
import LanguagePicker from './LanguagePicker.astro';
import Logo from './Logo.astro';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = dictionaries[lang].nav;
---

<header class="header">
	<div class="container bar">
		<a class="brand" href={getRelativeLocaleUrl(lang)} aria-label={t.home}>
			<Logo id="header-logo" size={28} />
			<span>Arrow</span>
		</a>
		<nav class="links" aria-label={t.label}>
			<a href="#features">{t.features}</a>
			<a href="#privacy">{t.privacy}</a>
			<a href="#open-source">{t.openSource}</a>
		</nav>
		<div class="tools">
			<LanguagePicker lang={lang} />
			<a class="github" href={GITHUB_URL} aria-label={t.github}>
				<svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M12 1.5a10.5 10.5 0 0 0-3.32 20.46c.53.1.72-.23.72-.5v-1.8c-2.92.63-3.54-1.25-3.54-1.25-.48-1.22-1.17-1.54-1.17-1.54-.95-.65.08-.64.08-.64 1.05.08 1.6 1.08 1.6 1.08.94 1.6 2.46 1.14 3.06.87.1-.68.37-1.14.66-1.4-2.33-.27-4.78-1.17-4.78-5.18 0-1.15.41-2.08 1.08-2.82-.1-.26-.47-1.33.1-2.78 0 0 .88-.28 2.89 1.08a10 10 0 0 1 5.26 0c2-1.36 2.88-1.08 2.88-1.08.58 1.45.21 2.52.1 2.78.68.74 1.09 1.67 1.09 2.82 0 4.02-2.46 4.9-4.8 5.17.38.32.71.96.71 1.94v2.87c0 .28.19.6.73.5A10.5 10.5 0 0 0 12 1.5z"
					></path>
				</svg>
			</a>
		</div>
	</div>
</header>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		border-bottom: 1px solid transparent;
		backdrop-filter: blur(18px) saturate(1.6);
		-webkit-backdrop-filter: blur(18px) saturate(1.6);
		transition: border-color 0.3s ease;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 64px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;

		svg {
			filter: drop-shadow(0 2px 4px rgb(110 80 200 / 0.3));
		}
	}

	.links {
		display: flex;
		gap: 28px;
		margin-inline: auto;

		a {
			color: var(--text-muted);
			font-size: 0.9375rem;
			font-weight: 500;
			text-decoration: none;
			transition: color 0.2s ease;

			&:hover {
				color: var(--text);
			}
		}
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.github {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		color: var(--text-muted);
		transition:
			color 0.2s ease,
			background-color 0.2s ease;

		&:hover {
			color: var(--text);
			background: var(--surface-muted);
		}
	}

	@media (max-width: 760px) {
		.links {
			display: none;
		}

		.tools {
			margin-inline-start: auto;
		}
	}

	/* A hairline appears under the bar once the page scrolls. */
	@supports (animation-timeline: scroll()) {
		@keyframes show-border {
			to {
				border-color: var(--line);
			}
		}

		.header {
			animation: show-border linear both;
			animation-timeline: scroll();
			animation-range: 0 80px;
		}
	}
</style>
