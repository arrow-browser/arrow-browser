<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Arrow</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HTML document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.html</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>XHTML document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.xhtml</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>Arrow Browser</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>arrowBrowser</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSEnvironment</key>
	<dict>
		<key>MallocNanoZone</key>
		<string>0</string>
	</dict>
	<!-- System menu items and panels follow the user's language, as in Arc. -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>LSFileQuarantineEnabled</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>Arrow.sdef</string>
	<!-- Ed25519 key that update archives must be signed with. The private key is in the
	     release machine's login Keychain ("Arrow Update Signing Key", scripts/sign-update.swift). -->
	<key>SUPublicEDKey</key>
	<string>KkOee5FOG7+33fn9zYU6VQEhOUq9gCJWG+XCgvIvUYg=</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Websites may use your bluetooth for features on their site.</string>
	<key>NSCameraUsageDescription</key>
	<string>Websites may use your camera for features on their site.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Websites may use your microphone for features on their site.</string>
	<key>NSLocationUsageDescription</key>
	<string>Websites may use your location for features on their site.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Websites may use your location for features on their site.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Access to "Downloads" is required for downloading files from the web.</string>
	<!-- View ▸ Cast: Chromium looks for Cast devices with Bonjour, as declared by Chrome. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_googlecast._tcp</string>
	</array>
	<key>NSDockTilePlugIn</key>
	<string>DockTilePlugIn.plugin</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Arrow — an open-source native browser.</string>
	<key>NSPrincipalClass</key>
	<string>ArrowApplication</string>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.euskadi31.arrow.sidebar-item</string>
			<key>UTTypeDescription</key>
			<string>Arrow sidebar item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>NSUserActivityTypeBrowsingWeb</string>
	</array>
</dict>
</plist>
